{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": { "#platform": ["src/platform/web.ts"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
